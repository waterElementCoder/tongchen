.page {
  padding-bottom: 32rpx;
}

/* 搜索栏 */
.search-bar {
  background: linear-gradient(135deg, #14b8a6, #0ea5a0);
  padding: 20rpx 24rpx 28rpx;
}
.search-inner {
  background: #ffffff;
  border-radius: 999rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}
.search-placeholder {
  color: #9ca3af;
  font-size: 26rpx;
}

/* Banner */
.banner-swiper {
  height: 300rpx;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.banner-img {
  width: 100%;
  height: 300rpx;
  border-radius: 24rpx;
}

/* 新人礼包 */
.newbie {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  background: linear-gradient(120deg, #fff4f2, #ffffff);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.newbie-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ef4444;
}
.newbie-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
}
.newbie-btn {
  background: #ef4444;
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-weight: 600;
}

/* 双专区 */
.zones {
  display: flex;
  margin: 0 24rpx 24rpx;
  gap: 20rpx;
}
.zone {
  flex: 1;
  padding: 32rpx 28rpx;
}
.zone-daily {
  background: linear-gradient(120deg, #e6f7f4, #ffffff);
}
.zone-sweet {
  background: linear-gradient(120deg, #fff0f0, #ffffff);
}
.zone-name {
  font-size: 32rpx;
  font-weight: 700;
}
.zone-daily .zone-name {
  color: #14b8a6;
}
.zone-sweet .zone-name {
  color: #ef4444;
}
.zone-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

/* 分类入口 */
.entries {
  margin: 0 24rpx 24rpx;
  padding: 28rpx 12rpx;
  display: flex;
}
.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.entry-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
}
.entry-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #4b5563;
  max-width: 120rpx;
}

/* 楼层 */
.floor {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
}
.floor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.floor-title {
  font-size: 32rpx;
  font-weight: 700;
}
.floor-more {
  font-size: 24rpx;
  color: #9ca3af;
}
.seckill-row {
  display: flex;
  gap: 20rpx;
}
.seckill-item {
  flex: 1;
  min-width: 0;
}
.seckill-img {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
}
.seckill-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #374151;
}
.seckill-price {
  margin-top: 6rpx;
  color: #ef4444;
  font-weight: 700;
  font-size: 26rpx;
}
.rec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.rec-item {
  width: calc(50% - 10rpx);
}
.rec-img {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
}
.rec-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #374151;
}
