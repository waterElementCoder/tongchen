<view class="page">
  <view class="form card">
    <view class="form-item">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入姓名" value="{{form.receiverName}}" data-field="receiverName" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{form.receiverPhone}}" data-field="receiverPhone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="form-picker {{region.length > 0 ? '' : 'placeholder'}}">
          {{region.length > 0 ? region[0] + ' ' + region[1] + ' ' + (region[2] || '') : '请选择省 / 市 / 区'}}
        </view>
      </picker>
    </view>
    <view class="form-item form-area">
      <text class="form-label">详细地址</text>
      <textarea class="form-textarea" placeholder="街道、门牌号、小区、楼栋号等" value="{{form.detailAddress}}" data-field="detailAddress" bindinput="onInput" maxlength="120" />
    </view>
    <view class="form-item form-switch">
      <text class="form-label">设为默认地址</text>
      <switch checked="{{form.isDefault === '1'}}" color="#14b8a6" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="btn-primary save-btn" bindtap="onSave">保存</view>
</view>
