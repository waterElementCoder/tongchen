<view class="page">
  <view class="list" wx:if="{{list.length > 0}}">
    <view class="addr card" wx:for="{{list}}" wx:key="id" data-index="{{index}}" bindtap="onSelect">
      <view class="addr-main">
        <view class="addr-top">
          <text class="addr-name">{{item.receiverName}}</text>
          <text class="addr-phone">{{item.receiverPhone}}</text>
          <text class="addr-default" wx:if="{{item.isDefaultFlag}}">默认</text>
        </view>
        <view class="addr-line">{{item.line}}</view>
      </view>
      <view class="addr-actions" wx:if="{{mode === 'view'}}">
        <text class="addr-action" data-index="{{index}}" catchtap="goEdit">编辑</text>
        <text class="addr-action addr-del" data-index="{{index}}" catchtap="onDelete">删除</text>
      </view>
      <text class="addr-check" wx:else>选择 ›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && list.length === 0}}">
    <view class="empty-icon">📍</view>
    <view>还没有收货地址</view>
  </view>

  <view class="bottom-bar">
    <view class="btn-primary add-btn" bindtap="goAdd">＋ 新增收货地址</view>
  </view>
</view>
