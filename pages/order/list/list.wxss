.page {
  padding-bottom: 32rpx;
}
.tabs {
  background: #ffffff;
  display: flex;
  padding: 0 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}
.tab.active {
  color: #14b8a6;
  font-weight: 700;
}
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #14b8a6;
}

.orders {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.order {
  padding: 24rpx 28rpx;
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.order-no {
  font-size: 24rpx;
  color: #6b7280;
}
.order-status {
  font-size: 26rpx;
  font-weight: 600;
}
.order-status.pay {
  color: #ef4444;
}
.order-status.ship {
  color: #f59e0b;
}
.order-status.receive {
  color: #14b8a6;
}
.order-status.done,
.order-status.cancel,
.order-status.refund,
.order-status.other {
  color: #9ca3af;
}
.order-goods {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  overflow-x: auto;
}
.order-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.order-foot {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 20rpx;
}
.order-count {
  font-size: 24rpx;
  color: #9ca3af;
}
.order-pay-label {
  font-size: 24rpx;
  color: #6b7280;
}
.order-pay-num {
  font-size: 34rpx;
}
.empty-btn {
  margin-top: 32rpx;
}
