<view class="page">
  <view class="result card">
    <view class="result-icon">{{paid ? '✅' : (pending ? '🔄' : '⏳')}}</view>
    <view class="result-title">{{paid ? '支付成功' : (pending ? '支付结果确认中' : '订单已提交，待支付')}}</view>
    <view class="result-desc" wx:if="{{orderNo}}">订单号：{{orderNo}}</view>
    <view class="result-desc" wx:if="{{pending}}">已完成云闪付付款？点击「查看订单状态」刷新</view>
    <view class="result-desc" wx:elif="{{!paid}}">可在订单详情中继续支付</view>
  </view>

  <view class="actions">
    <view class="btn-secondary" bindtap="goOrderList">查看订单</view>
    <view class="btn-primary action-main" bindtap="goOrderDetail">查看订单详情</view>
  </view>
  <view class="back-home" bindtap="goHome">返回首页 ›</view>
</view>
