.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  background: linear-gradient(180deg, #e6f7f4 0%, #f6f7f9 40%);
}

.logo-area {
  margin-top: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #14b8a6, #0ea5a0);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
  box-shadow: 0 16rpx 40rpx rgba(20, 184, 166, 0.3);
}
.logo-name {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 700;
}
.logo-slogan {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.login-btn {
  margin-top: 160rpx;
  width: 100%;
}
.login-btn.disabled {
  opacity: 0.6;
}

.tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 手机号授权卡片 */
.phone-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 120rpx;
  padding: 48rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.phone-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}
.phone-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
  text-align: center;
}
.phone-btn-primary {
  margin-top: 44rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #14b8a6, #0ea5a0);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}
.phone-btn-primary::after {
  border: none;
}
.phone-skip {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #9ca3af;
  padding: 12rpx 24rpx;
}

.dev-panel {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.dev-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #f59e0b;
}
.dev-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.6;
}
.dev-input {
  margin-top: 16rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
}

.agree-row {
  margin-top: 32rpx;
}
.agree-label {
  display: flex;
  align-items: center;
}
.agree-text {
  font-size: 22rpx;
  color: #9ca3af;
}

.skip {
  margin-top: auto;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  color: #9ca3af;
  font-size: 26rpx;
}
