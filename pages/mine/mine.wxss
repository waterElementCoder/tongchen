.page {
  padding-bottom: 40rpx;
}
.header {
  background: linear-gradient(135deg, #14b8a6, #0ea5a0);
  padding: 48rpx 32rpx 72rpx;
}
.user-row {
  display: flex;
  align-items: center;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-holder {
  font-size: 56rpx;
}
.user-info {
  flex: 1;
  margin-left: 24rpx;
  color: #ffffff;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
}
.user-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}
.login-btn {
  background: #ffffff;
}

.panel {
  margin: -44rpx 24rpx 20rpx;
  position: relative;
  padding: 28rpx;
}
.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}
.panel-more {
  font-size: 24rpx;
  color: #9ca3af;
}
.order-tabs {
  display: flex;
}
.order-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.order-tab-icon {
  font-size: 44rpx;
}
.order-tab-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.cell {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.cell:last-child {
  border-bottom: none;
}
.cell-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}
.cell-name {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
}
.cell-arrow {
  color: #d1d5db;
  font-size: 36rpx;
}
.cell-value {
  font-size: 26rpx;
  color: #6b7280;
}
.phone-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  color: #14b8a6;
  background: #e6f7f4;
  border-radius: 26rpx;
  border: none;
}
.phone-btn::after {
  border: none;
}
