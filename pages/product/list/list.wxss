.page {
  padding-bottom: 32rpx;
}

.sort-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
  display: flex;
  padding: 20rpx 32rpx;
  margin-bottom: 20rpx;
}
.sort-item {
  margin-right: 56rpx;
  font-size: 28rpx;
  color: #6b7280;
}
.sort-item.active {
  color: #14b8a6;
  font-weight: 700;
}
.sort-arrow {
  font-size: 24rpx;
}

.goods {
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.goods-item {
  display: flex;
  padding: 20rpx;
}
.goods-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  position: relative;
}
.goods-name {
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.4;
}
.goods-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}
.goods-bottom {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.goods-price-num {
  font-size: 34rpx;
}
.goods-sales {
  font-size: 22rpx;
  color: #9ca3af;
}
.goods-out {
  position: absolute;
  right: 0;
  top: -40rpx;
  font-size: 20rpx;
  color: #9ca3af;
  background: #f3f4f6;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}

.list-footer {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 32rpx 0;
}
